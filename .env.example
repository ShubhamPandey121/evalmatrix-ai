# Backend Port
PORT=3000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/evalmatrix_ai

# JWT Secret Key for Authentication
JWT_SECRET=evalmatrix_ai_shubham_pandey_super_secret_jwt_key_2026

# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL (For CORS Whitelist)
FRONTEND_URL=http://localhost:5173
